---
import Layout from '../layouts/Layout.astro';
import Compartir from '../components/Compartir.astro';
import { chisteDelDia, categorias, SITIO } from '../utils/chiste';

const { fecha, chiste } = chisteDelDia();
const cats = categorias();

const fechaBonita = new Date(`${fecha}T12:00:00`).toLocaleDateString('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Chiste malo del día',
  url: `${SITIO}/`,
  inLanguage: 'es',
};
---

<Layout
  title="Chiste malo del día | Un chiste malo nuevo cada día"
  description="Un chiste malo distinto cada día para sacarte una sonrisa (o un suspiro). Compártelo con quien más lo merezca."
  jsonLd={jsonLd}
>
  <main>
    <header>
      <p class="fecha">{fechaBonita}</p>
      <h1>Chiste malo <span>del día</span></h1>
    </header>

    <article class="tarjeta">
      <p class="chiste">{chiste.texto}</p>
      <Compartir texto={chiste.texto} url={`${SITIO}/chiste/${chiste.slug}/`} />
    </article>

    <p class="nota">
      Más chistes de <a href={`/categoria/${chiste.catSlug}/`}>{chiste.categoria}</a> ·
      <a href="/chistes-anteriores/">ver chistes anteriores</a>
    </p>

    <h2>Chistes por categorías</h2>
    <div class="chips">
      {cats.map((c) => <a class="chip" href={`/categoria/${c.slug}/`}>{c.nombre} ({c.chistes.length})</a>)}
    </div>
  </main>
</Layout>